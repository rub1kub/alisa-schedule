# Copy to .env for Docker Compose. Never commit personal environment files.
# Until a real skill ID is available, use development on the loopback port only.
APP_ENV=production
ALICE_SKILL_ID=
SCHEDULE_PROVIDER=kkepik
API_BASE_URL=https://kkepik.rub1kub.ru
COLLEGE_FILE=/app/data/college.json
RESPONSES_FILE=/app/data/responses.json
OVERRIDES_FILE=/app/data/overrides.json
SCHEDULE_FILE=/app/data/schedule.example.json
CACHE_TTL_SECONDS=60
STALE_TTL_SECONDS=180
UPSTREAM_TIMEOUT_SECONDS=1.8
UPSTREAM_RPS=4
